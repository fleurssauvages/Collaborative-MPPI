<mujoco model="dual_panda_air_hockey">
  <!-- Air hockey table. The two Panda arms are attached in Python (collab_mppi/robot.py)
       at x = -0.75 (left) and x = +0.75 (right). The table runs along x between them,
       with side rails and open ends; a puck rolling off an end counts as a drop. -->
  <option timestep="0.005" integrator="implicit"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="90" elevation="-25" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.28 0.38 0.52" rgb2="0.03 0.04 0.06"
             width="512" height="3072"/>
    <texture type="2d" name="ground" builtin="checker" mark="edge"
             rgb1="0.18 0.20 0.22" rgb2="0.10 0.11 0.12" markrgb="0.7 0.7 0.7"
             width="300" height="300"/>
    <material name="ground" texture="ground" texuniform="true" texrepeat="5 5"/>
    <material name="table" rgba="0.35 0.45 0.38 1"/>
    <material name="rail" rgba="0.55 0.42 0.30 1"/>
  </asset>

  <worldbody>
    <light pos="0 -0.6 2.0" dir="0 0.3 -1" directional="true"/>
    <geom name="floor" type="plane" size="2 2 0.05" material="ground"/>

    <!-- Table top at z = 0.20 spanning x in [-0.5, 0.5], y in [-0.25, 0.25]. -->
    <!-- condim 1: a frictionless air hockey surface for the puck and the stick tip discs. -->
    <geom name="table" type="box" pos="0 0 0.1" size="0.5 0.25 0.1" material="table" condim="1"/>
    <!-- Bouncy rails (direct solref: low damping), so the puck rebounds instead of hugging them. -->
    <geom name="rail_left" type="box" pos="0 0.26 0.215" size="0.5 0.01 0.015" material="rail"
          condim="1" solref="-5000 -10"/>
    <geom name="rail_right" type="box" pos="0 -0.26 0.215" size="0.5 0.01 0.015" material="rail"
          condim="1" solref="-5000 -10"/>
    <!-- Midline: visual only. -->
    <geom type="box" pos="0 0 0.2005" size="0.004 0.25 0.0005" rgba="0.9 0.9 0.9 0.6"
          contype="0" conaffinity="0"/>
    <!-- Middle no-go zone for the robots (x in [-0.1, 0.1]), marked as a strip on the table:
         the MPPI cost penalizes entering it. Its half-width is read from here by
         collab_mppi/air_hockey/task.py. -->
    <geom name="middle_zone" type="box" pos="0 0 0.2006" size="0.1 0.25 0.0005" rgba="0.9 0.25 0.2 0.35"
          contype="0" conaffinity="0"/>

    <!-- Air hockey puck, frictionless (condim 1) against the
         table, the rails and the stick tip discs. -->
    <body name="puck" pos="-0.25 0 0.212">
      <freejoint name="puck"/>
      <geom name="puck" type="cylinder" size="0.035 0.012" mass="0.1" condim="1"
            rgba="0.95 0.85 0.15 1"/>
    </body>

    <!-- Target markers expected by collab_mppi/robot.py; hidden in this task. -->
    <body name="left_target" mocap="true" pos="-0.35 0 0.35">
      <geom type="sphere" size="0.015" rgba="0 0 0 0" contype="0" conaffinity="0"/>
    </body>
    <body name="right_target" mocap="true" pos="0.35 0 0.35">
      <geom type="sphere" size="0.015" rgba="0 0 0 0" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  <sensor>
    <framepos name="puck_pos" objtype="xbody" objname="puck"/>
    <framelinvel name="puck_vel" objtype="xbody" objname="puck"/>
    <!-- Net contact force between each arm (whole subtree) and the puck. -->
    <contact name="left_push" geom1="puck" subtree2="left_link0" num="1" data="force" reduce="netforce"/>
    <contact name="right_push" geom1="puck" subtree2="right_link0" num="1" data="force" reduce="netforce"/>
  </sensor>
</mujoco>
